    <key>looks</key><string>Fewer local reflections in busy places</string>
    <key>description</key><string>Halves the number of reflection probes kept. Fewer probes are updated and searched for each pixel of the lighting pass.</string>
  </map>
  <map>
    <key>id</key><string>ssr_half_res</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:SSR trace</string><string>gpu:SSR alpha</string><string>gpu:SSR water</string><string>gpu:SSR mip chain</string></array>
    <key>min_ms</key><real>0.3</real>
    <key>fraction</key><real>0.55</real>
    <key>when</key><array><string>RenderScreenSpaceReflections eq 1</string><string>RenderScreenSpaceReflectionsResolutionMultiplier gt 0.55</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderScreenSpaceReflectionsResolutionMultiplier</string><key>value</key><string>0.5</string></map>
    </array>
    <key>looks</key><string>Reflections slightly softer on fine normal-map detail</string>
    <key>description</key><string>Screen-space reflections are traced at half resolution and read back filtered.</string>
  </map>
  <map>
    <key>id</key><string>ssr_iterations</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:SSR trace</string><string>gpu:SSR alpha</string><string>gpu:SSR water</string></array>
    <key>min_ms</key><real>0.4</real>
    <key>fraction</key><real>0.3</real>
    <key>when</key><array><string>RenderScreenSpaceReflections eq 1</string><string>RenderScreenSpaceReflectionIterations gt 16</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderScreenSpaceReflectionIterations</string><key>value</key><string>x0.5</string><key>min</key><real>12.0</real></map>
    </array>
    <key>looks</key><string>Reflections of far things may be missed</string>
    <key>description</key><string>Halves the most steps a screen-space reflection ray may take through the depth pyramid.</string>
  </map>
  <map>
    <key>id</key><string>ssr_off</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:SSR trace</string><string>gpu:SSR alpha</string><string>gpu:SSR water</string><string>gpu:SSR mip chain</string><string>gpu:ssr copy</string><string>gpu:build Hi-Z</string><string>gpu:ssr stage</string></array>
