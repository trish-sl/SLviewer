    <key>bound</key><string>capped</string>
    <key>when</key><array><string>$headroom_ms ge 2</string><string>FSRenderWaterRipples eq 0</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>FSRenderWaterRipples</string><key>value</key><string>1</string></map>
    </array>
    <key>effect</key><string>uses headroom</string>
    <key>looks</key><string>Water reacts to avatars, boats and splashes</string>
    <key>description</key><string>There is headroom: interactive water ripples on, with rings, wakes and splashes around avatars and moving objects in the water. About 0.1 to 0.2 ms of GPU time. Rebuilds the shaders.</string>
