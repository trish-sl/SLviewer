    <key>set</key><array>
      <map><key>setting</key><string>RenderAvatarMaxNonImpostors</string><key>value</key><string>+4</string><key>max</key><real>12.0</real></map>
    </array>
    <key>effect</key><string>uses headroom</string>
    <key>looks</key><string>More avatars fully drawn</string>
    <key>description</key><string>There is headroom: four more avatars drawn fully instead of as impostors.</string>
  </map>
</array>
