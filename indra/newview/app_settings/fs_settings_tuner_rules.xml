<?xml version="1.0" encoding="utf-8"?>
<!--
  Rules of the settings tuner (Preferences > Experimental > General > Suggest settings..., fssettingstuner.cpp).
  An LLSD array of maps, one rule each:
    id           a name, shown in the copied report
    bound        when it applies, comma separated: gpu, cpu, capped (frame limit or vsync leaves headroom),
                 memory (texture memory short: the discard bias above 1.3 at least half the time), any.
                 When the main thread and the GPU are both near the frame time ("balanced"), gpu and cpu
                 rules both apply; the saving shown is then what the frame gains: the main thread part
                 (cpu zones) and the GPU part (gpu zones) each cut their side, and the slower side
                 sets the frame. Rules with the same changes are shown as one row.
    zones        measured times summed, ms a frame: "gpu:<GPU zone>" (LL_PROFILE_GPU_ZONE names),
                 "cpu:<block timer>" (own time) or "cpui:<block timer>" (with children)
    min_ms       the sum must reach this (rules without zones skip the test)
    min_share    and this share of the frame time (optional)
    fraction     estimated saving = the sum times this
    when         all must hold: "<setting or $measurement> <eq|ne|gt|ge|lt|le> <number>". A setting this build
                 doesn't have makes the rule not apply. Measurements: $frame_ms $fps $gpu_ms $cpu_busy_ms
                 $sleep_ms $swap_ms $wait_ms $headroom_ms $bias $bias_max $bias_high_frac $tight_frac
                 $vram_used_mb $vram_target_mb $vram_free_frac $avatars $full_avatars $visible_avatars
                 $particles $max_particles $fps_limit $vsync $amd $nvidia $intel $gpu_bound $cpu_bound
                 $balanced $capped $memory_bound $gpu_timed $gpu_frame_ms
    set          changes: setting, value ("x2" multiplies, "+1"/"-1" add, "=-1" or a plain number sets), min, max
    effect       the "Saves" column of rules without a saving estimate
    looks        the visual cost, short
    description  what it does, shown when the row is selected
  A rule is listed only when at least one of its settings would really change.
  Regenerated from a table; keep the format if editing by hand.
-->
<llsd>
<array>
  <map>
    <key>id</key><string>probe_refresh_interval</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:probe update</string></array>
    <key>min_ms</key><real>0.6</real>
    <key>fraction</key><real>0.4</real>
    <key>when</key><array><string>RenderReflectionProbeLevel ge 0</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderReflectionProbeRefreshFrameInterval</string><key>value</key><string>x2</string><key>min</key><real>2.0</real><key>max</key><real>8.0</real></map>
    </array>
    <key>looks</key><string>Reflections of changes nearby catch up a little later</string>
    <key>description</key><string>Reflection probes that are already complete refresh one cube face every few frames instead of every frame. New probes still update at once.</string>
  </map>
  <map>
    <key>id</key><string>probe_realtime_off</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:probe update</string></array>
    <key>min_ms</key><real>0.5</real>
    <key>fraction</key><real>0.5</real>
    <key>when</key><array><string>RenderReflectionProbeDetail eq 2</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderReflectionProbeDetail</string><key>value</key><string>1</string></map>
    </array>
    <key>looks</key><string>Moving avatars and objects show in reflections with a delay</string>
    <key>description</key><string>Reflection detail goes from Real-time to Static and dynamic: the probe around the camera is no longer redrawn every frame.</string>
  </map>
  <map>
    <key>id</key><string>probe_realtime_faces</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:probe update</string></array>
    <key>min_ms</key><real>0.5</real>
    <key>fraction</key><real>0.4</real>
    <key>when</key><array><string>RenderReflectionProbeDetail eq 2</string><string>FSPerfProbeRealtimeFacesPerFrame gt 2</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>FSPerfProbeRealtimeFacesPerFrame</string><key>value</key><string>2</string></map>
    </array>
    <key>looks</key><string>Real-time reflections update a little less smoothly</string>
    <key>description</key><string>The real-time reflection probe renders two cube faces a frame instead of the whole cube, so a full update is spread over three frames.</string>
  </map>
  <map>
    <key>id</key><string>probe_draw_distance</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:cubeSnapshot</string></array>
    <key>min_ms</key><real>0.6</real>
    <key>fraction</key><real>0.3</real>
    <key>when</key><array><string>RenderReflectionProbeDrawDistance gt 40</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderReflectionProbeDrawDistance</string><key>value</key><string>x0.5</string><key>min</key><real>32.0</real></map>
    </array>
    <key>looks</key><string>Distant scenery drops out of reflections</string>
    <key>description</key><string>Reflection probes draw the scene only to half the distance. Each probe update draws less, which matters most in built-up places.</string>
  </map>
  <map>
    <key>id</key><string>probe_level</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:probe update</string></array>
    <key>min_ms</key><real>1.0</real>
    <key>fraction</key><real>0.3</real>
    <key>when</key><array><string>RenderReflectionProbeLevel eq 3</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderReflectionProbeLevel</string><key>value</key><string>2</string></map>
    </array>
    <key>looks</key><string>Objects lose their automatic reflection probes; placed probes, terrain and water keep theirs</string>
    <key>description</key><string>Reflection coverage goes from "manual, terrain, water and objects" to "manual, terrain and water", so there are fewer probes to update.</string>
  </map>
  <map>
    <key>id</key><string>probe_count</string>
    <key>bound</key><string>gpu</string>
    <key>zones</key><array><string>gpu:probe update</string><string>gpu:atmospherics</string></array>
    <key>min_ms</key><real>1.5</real>
    <key>fraction</key><real>0.15</real>
    <key>when</key><array><string>RenderReflectionProbeLevel ge 1</string><string>RenderReflectionProbeCount gt 64</string></array>
    <key>set</key><array>
      <map><key>setting</key><string>RenderReflectionProbeCount</string><key>value</key><string>x0.5</string><key>min</key><real>32.0</real></map>
